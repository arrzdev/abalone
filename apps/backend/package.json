{
  "name": "@repo/backend",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "@/entrypoint": "./entrypoint/worker.ts",
    "@/env/*": "./env/*",
    "@/ports": "./ports.ts",
    "@/*": "./src/*"
  },
  "exports": {
    "./http/interface": "./src/http/interface.ts",
    "./http/errors": "./src/http/errors.ts",
    "./realtime/events": "./src/modules/realtime/events.ts"
  },
  "scripts": {
    "check:env": "tsx env/check-env.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "wrangler deploy --dry-run --env production",
    "start": "wrangler dev --env-file env/.env",
    "biome:fix": "biome check --write --unsafe .",
    "biome:check": "biome check .",
    "tail": "wrangler tail --format pretty",
    "db:check": "drizzle-kit check --config ./src/database/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./src/database/drizzle.config.ts",
    "migrate:local": "pnpm run db:generate && wrangler d1 migrations apply abalone-backend-db-dev --local",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/zod-validator": "0.8.0",
    "@repo/abalone-engine": "workspace:*",
    "@repo/dev": "workspace:*",
    "better-auth": "1.6.28",
    "@repo/env-validation": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.11.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.12",
    "@cloudflare/workers-types": "4.20260317.1",
    "@types/node": "22.19.17",
    "drizzle-kit": "0.31.4",
    "tsx": "4.19.3",
    "vitest": "4.1.2",
    "wrangler": "4.78.0"
  }
}
