# Backend env — the documented contract. Copy this to `env/.env` and fill in real
# values. `check:env` validates `env/.env`; `wrangler dev` loads it at runtime via
# `--env-file env/.env`, and deploy uploads the same file as Worker secrets.

# The web app origin. Two jobs: it is the CORS allowlist, and it is the single
# signal src/http/network-policy.ts reads to decide whether this is a dev
# environment — a localhost/LAN value reflects private origins, an https one
# never does. Point it at whichever app calls this API.
FRONTEND_URL=http://localhost:6161

# Signs sessions and bearer tokens. At least 16 characters, and never shared
# between environments. Generate one with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me

# This API's own public origin, with no trailing slash. better-auth builds its
# absolute URLs from it, so it is the backend hostname, not the frontend's.
BETTER_AUTH_URL=http://localhost:8181

# Where avatar objects are readable from, with no trailing slash. An avatar URL
# is `<this>/<object key>`, and every key already starts with `avatars/`. In
# production this is the R2 bucket's own custom domain and no worker is on the
# read path. Locally there is no such domain — wrangler emulates the binding, not
# public bucket access — so it is this API's own base, under which `/avatars/*`
# is the dev-only passthrough route: the key's own prefix IS the mount path, so
# the value stops at `/v1`. Dev therefore needs no network for avatars either.
AVATAR_PUBLIC_URL=http://localhost:8181/api/v1
