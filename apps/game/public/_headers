# Workers static assets read this file at deploy; it is not served.
# Security headers on every static file. Keep equal to SECURITY_HEADERS in
# src/server/security-headers.ts, which sets them on the Worker's own
# responses; security-headers.test.ts checks both. No Cache-Control here:
# two matching rules join their values with a comma.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Build files carry a content hash in the name, so they never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The prerendered SPA shell the app boots from. It carries the home head, so a
# crawler that finds it lists a second home page under this URL. noindex keeps
# it out of results; robots.txt must not block it, or the crawler never reads
# this header.
/_shell
  X-Robots-Tag: noindex

# The service worker script and the offline fallback page are for the browser
# to fetch, not for people to land on. Both answer 200, so a crawler that
# follows the registration can list them. Same rule as /_shell: robots.txt must
# not block them, or the crawler never reads this header.
/sw.js
  X-Robots-Tag: noindex
/_pwa/*
  X-Robots-Tag: noindex
