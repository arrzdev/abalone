{
  "name": "@repo/game",
  "private": true,
  "type": "module",
  "imports": {
    "@/env/*": "./env/*",
    "@/ports": "./ports.ts",
    "@/*": "./src/*"
  },
  "scripts": {
    "check:env": "tsx env/check-env.ts",
    "avatars": "pnpm dlx svgo -f assets/avatars -o node_modules/.avatars --config scripts/avatars/svgo.config.mjs && node scripts/avatars/generate.mjs node_modules/.avatars src/components/avatars scripts/avatars/crop.json",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "biome:fix": "biome check --write .",
    "biome:check": "biome check .",
    "start": "vite preview",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@repo/abalone-engine": "workspace:*",
    "@repo/backend": "workspace:*",
    "@repo/dev": "workspace:*",
    "@repo/env-validation": "workspace:*",
    "@repo/nativ": "workspace:*",
    "@repo/shared": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.7",
    "hono": "4.13.13",
    "i18next": "23.16.8",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.52.0",
    "motion": "12.35.0",
    "partysocket": "1.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "15.7.4",
    "tailwindcss": "4.2.4",
    "tailwindcss-safe-area": "1.3.0",
    "vite": "8.0.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260317.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "vitest": "4.1.2",
    "wrangler": "4.149.0"
  }
}
