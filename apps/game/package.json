{
  "name": "@repo/game",
  "private": true,
  "type": "module",
  "imports": {
    "@/env/*": "./env/*",
    "@/ports": "./ports.ts",
    "@/*": "./src/*"
  },
  "scripts": {
    "check:env": "tsx env/check-env.ts",
    "avatars": "pnpm dlx svgo -f assets/avatars -o node_modules/.avatars --config scripts/avatars/svgo.config.mjs && node scripts/avatars/generate.mjs node_modules/.avatars src/components/avatars scripts/avatars/crop.json",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "biome:fix": "biome check --write .",
    "biome:check": "biome check .",
    "start": "vite preview",
    "test": "echo \"No tests configured\""
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.30.2",
    "@repo/abalone-engine": "workspace:*",
    "@repo/backend": "workspace:*",
    "@repo/dev": "workspace:*",
    "@repo/env-validation": "workspace:*",
    "@repo/nativ": "workspace:*",
    "@repo/shared": "workspace:*",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.168.8",
    "@tanstack/react-start": "1.167.13",
    "better-auth": "1.6.28",
    "hono": "4.11.8",
    "i18next": "23.16.8",
    "lucide-react": "1.31.0",
    "motion": "12.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "15.7.4",
    "tailwindcss": "4.2.4",
    "tailwindcss-safe-area": "1.3.0",
    "vite": "8.0.11",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260317.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.19.3",
    "wrangler": "4.78.0"
  }
}
