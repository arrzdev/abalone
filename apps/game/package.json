{
  "name": "@repo/game",
  "private": true,
  "type": "module",
  "imports": {
    "@/env/*": "./env/*",
    "@/ports": "./ports.ts",
    "@/*": "./src/*"
  },
  "scripts": {
    "check:env": "tsx env/check-env.ts",
    "avatars": "pnpm dlx svgo -f assets/avatars -o node_modules/.avatars --config scripts/avatars/svgo.config.mjs && node scripts/avatars/generate.mjs node_modules/.avatars src/components/avatars scripts/avatars/crop.json",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "biome:fix": "biome check --write .",
    "biome:check": "biome check .",
    "start": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@repo/abalone-engine": "workspace:*",
    "@repo/backend": "workspace:*",
    "@repo/dev": "workspace:*",
    "@repo/env-validation": "workspace:*",
    "@repo/nativ": "workspace:*",
    "@repo/shared": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "1.7.25",
    "hono": "4.13.18",
    "i18next": "25.10.10",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.73.0",
    "motion": "12.43.0",
    "partysocket": "1.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "16.6.6",
    "tailwindcss": "4.3.5",
    "tailwindcss-safe-area": "1.3.0",
    "vite": "8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
