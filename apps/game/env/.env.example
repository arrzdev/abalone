# Game env — the documented contract. Copy this to `env/.env` and fill in real
# values. Everything here is baked into the browser bundle at build time, so
# nothing in this file can ever be a secret. CI builds from these placeholders
# (it does not run `check:env`), and deploy uses the real GitHub environment.

# Where the API lives in dev. The client keeps this port but swaps in whatever
# hostname the page was loaded from, so a phone on the LAN reaches the backend
# with no edit here. Production leaves it unset: the game calls /api/v1 on the
# origin it was loaded from.
VITE_BACKEND_URL=http://localhost:8181
