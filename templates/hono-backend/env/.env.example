# Backend env — the documented contract. Copy this to `env/.env` and fill in real
# values. `check:env` validates `env/.env`; `wrangler dev` loads it at runtime via
# `--env-file env/.env`, and deploy uploads the same file as Worker secrets.

# Every origin the web app is served from, comma-separated. Two jobs: it is the
# CORS allowlist, and it is the single signal src/http/network-policy.ts reads
# to decide whether this is a dev environment — an all-localhost/LAN value
# reflects private origins, an https one never does. List whichever apps call
# this API.
FRONTEND_URLS=http://localhost:6161

# The lowest log level written: debug, info, warn or error. Optional, info when
# unset. Staging sets
# debug (a LOG_LEVEL variable on the staging GitHub Environment); production
# leaves it unset.
LOG_LEVEL=info
