{
  "name": "@repo/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "@/entrypoint": "./entrypoint/worker.ts",
    "@/env/*": "./env/*",
    "@/*": "./src/*"
  },
  "exports": {
    "./http/interface": "./src/http/interface.ts",
    "./http/errors": "./src/http/errors.ts"
  },
  "scripts": {
    "check:env": "tsx env/check-env.ts",
    "dev": "wrangler dev --env-file env/.env",
    "build": "wrangler deploy --dry-run --env ${CLOUDFLARE_ENV:-production}",
    "biome:fix": "biome check --write --unsafe .",
    "biome:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail --format pretty",
    "db:check": "drizzle-kit check --config ./src/database/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./src/database/drizzle.config.ts",
    "migrate:local": "pnpm run db:generate && wrangler d1 migrations apply hono-backend-db-dev --local",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "4.20260317.1",
    "@types/node": "22.19.17",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "sharp": "0.35.5",
      "undici@7": "7.30.1",
      "zod@4": "4.6.7"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4"
}
