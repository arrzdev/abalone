{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.tsbuild",
      "!!**/coverage",
      "!!**/*.tsbuildinfo",
      "!!**/database/migrations",
      "!!**/env/.env",
      "!!**/env/.env.*",
      "!!**/.env",
      "!!**/.env.*",
      "!!**/.wrangler",
      "!!**/*.log",
      "!!**/pnpm-lock.yaml",
      "!!.claude"
    ],
    "ignoreUnknown": true
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./*", "../*"],
                "message": "Use the member self-alias (@/* in apps, #<slug>/* in packages), not ./ or ../."
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 75
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  }
}
